  m_text: "Cuatro grandes corporaciones dominan la estructura econ\xF3mica y tecnol\xF3gica
    de la megametr\xF3polis. Sus intereses se extienden m\xE1s all\xE1 de la ciudad,
    impuls\xE1ndolas a organizar expediciones hacia territorios abandonados en busca
    de tecnolog\xEDa y recursos antiguos."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
